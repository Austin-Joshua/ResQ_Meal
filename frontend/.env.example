# Frontend API base path (Vite dev server proxies /api → Spring Boot on 8080).
# VITE_API_URL=/api
# Real-time Socket.IO (Spring netty-socketio; default port 9090).
# VITE_SOCKET_URL=http://localhost:9090

# Traffic ML is invoked server-side (backend/.env or application.properties):
# TRAFFIC_SECURITY_ML_ENABLED, TRAFFIC_SECURITY_ML_URL — see backend/.env.example
