# --- Default dev wiring (leave unset): same-origin /api + /socket.io via Vite proxy → Spring (8080) + Socket.IO (9090)
# VITE_API_URL=/api
#
# Override only when the UI is hosted on a different origin than the API:
# VITE_API_URL=https://api.example.com/api
#
# Socket: in `npm run dev`, same-origin is used so Vite can proxy /socket.io → 9090.
# Set this only for custom deployments (e.g. TLS terminator in front of Socket.IO only):
# VITE_SOCKET_URL=https://ws.example.com

# Traffic ML is invoked server-side (backend/.env or application.properties):
# TRAFFIC_SECURITY_ML_ENABLED, TRAFFIC_SECURITY_ML_URL — see backend/.env.example
