# Spring Boot (see also src/main/resources/application.properties)
PORT=8080

# MySQL (same schema as database/database.sql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=resqmeal_db
DB_USER=root
DB_PASSWORD=your_password
DB_POOL_LIMIT=10

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_make_it_long_and_random

UPLOAD_DIR=uploads
API_URL=http://localhost:8080

# Socket.IO (netty-socketio; separate port from HTTP)
SOCKETIO_PORT=9090
SOCKETIO_HOST=0.0.0.0

# Optional ML HTTP services (same as Node backend)
# FRESHNESS_AI_URL=http://localhost:8000
# FRESHNESS_ENV_AI_URL=http://localhost:8001
# FOOD_IMAGE_RECOGNITION_URL=http://localhost:8005

# --- Security monitoring (optional) ---
# Comma-separated numeric user ids from `users.id` — grants ROLE_ADMIN and /api/admin/* + SPA /Admin
# Example: ADMIN_USER_IDS=1,42
ADMIN_USER_IDS=

# Telegram Bot API (optional; leave blank to disable instant alerts)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890

# Rate limits (defaults match application.properties)
# APP_SECURITY_MAX_FAILED_LOGINS_PER_MINUTE=5
# APP_SECURITY_MAX_MUTATIONS_PER_MINUTE=20

# Traffic ML security layer (optional; run ml/traffic-security/server.py)
# TRAFFIC_SECURITY_ML_ENABLED=true
# TRAFFIC_SECURITY_ML_URL=http://127.0.0.1:8091
# Optional Firebase Cloud Function or HTTPS webhook for mobile push alerts
# FIREBASE_SECURITY_WEBHOOK_URL=
# FIREBASE_SECURITY_WEBHOOK_SECRET=
# TRAFFIC_SECURITY_BLOCK_ON_MALICIOUS=false
